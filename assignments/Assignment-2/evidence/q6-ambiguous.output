Grammar

    0 $accept: program $end

    1 program: /* empty */
    2        | program stmt

    3 stmt: LET ID ';'
    4     | ID '=' expr ';'
    5     | IF '(' expr ')' stmt ELSE stmt
    6     | error ';'

    7 expr: expr OR expr
    8     | expr AND expr
    9     | expr EQ expr
   10     | expr '<' expr
   11     | expr '+' expr
   12     | expr '-' expr
   13     | expr '*' expr
   14     | expr '/' expr
   15     | '(' expr ')'
   16     | ID
   17     | NUM


