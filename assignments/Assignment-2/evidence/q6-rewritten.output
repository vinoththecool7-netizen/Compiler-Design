Grammar

    0 $accept: program $end

    1 program: /* empty */
    2        | program stmt

    3 stmt: LET ID ';'
    4     | ID '=' expr ';'
    5     | IF '(' expr ')' stmt ELSE stmt
    6     | error ';'

    7 expr: andexpr
    8     | expr OR andexpr

    9 andexpr: cmp
   10        | andexpr AND cmp

   11 cmp: sum
   12    | sum EQ sum
   13    | sum '<' sum

   14 sum: product
   15    | sum '+' product
   16    | sum '-' product

   17 product: unary
   18        | product '*' unary
   19        | product '/' unary

   20 unary: '-' unary
   21      | atom

   22 atom: ID
   23     | NUM
   24     | '(' expr ')'


Terminals, with rules where they appear

$end (0) 0
'(' (40) 5 24
')' (41) 5 24
'*' (42) 18
'+' (43) 15
'-' (45) 16 20
'/' (47) 19
';' (59) 3 4 6
'<' (60) 13
'=' (61) 4
error (256) 6
ID (258) 3 4 22
NUM (259) 23
LET (260) 3
IF (261) 5
ELSE (262) 5
AND (263) 10
OR (264) 8
EQ (265) 12


Nonterminals, with rules where they appear

$accept (20)
    on left: 0
program (21)
    on left: 1 2, on right: 0 2
stmt (22)
    on left: 3 4 5 6, on right: 2 5
expr (23)
    on left: 7 8, on right: 4 5 8 24
andexpr (24)
    on left: 9 10, on right: 7 8 10
cmp (25)
    on left: 11 12 13, on right: 9 10
sum (26)
    on left: 14 15 16, on right: 11 12 13 15 16
product (27)
    on left: 17 18 19, on right: 14 15 16 18 19
unary (28)
    on left: 20 21, on right: 17 18 19 20
atom (29)
    on left: 22 23 24, on right: 21


state 0

    0 $accept: . program $end

    $default  reduce using rule 1 (program)

    program  go to state 1


state 1

    0 $accept: program . $end
    2 program: program . stmt

    $end   shift, and go to state 2
    error  shift, and go to state 3
    ID     shift, and go to state 4
    LET    shift, and go to state 5
    IF     shift, and go to state 6

    stmt  go to state 7


state 2

    0 $accept: program $end .

    $default  accept


state 3

    6 stmt: error . ';'

    ';'  shift, and go to state 8


state 4

    4 stmt: ID . '=' expr ';'

    '='  shift, and go to state 9


state 5

    3 stmt: LET . ID ';'

    ID  shift, and go to state 10


state 6

    5 stmt: IF . '(' expr ')' stmt ELSE stmt

    '('  shift, and go to state 11


state 7

    2 program: program stmt .

    $default  reduce using rule 2 (program)


state 8

    6 stmt: error ';' .

    $default  reduce using rule 6 (stmt)


state 9

    4 stmt: ID '=' . expr ';'

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    expr     go to state 16
    andexpr  go to state 17
    cmp      go to state 18
    sum      go to state 19
    product  go to state 20
    unary    go to state 21
    atom     go to state 22


state 10

    3 stmt: LET ID . ';'

    ';'  shift, and go to state 23


state 11

    5 stmt: IF '(' . expr ')' stmt ELSE stmt

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    expr     go to state 24
    andexpr  go to state 17
    cmp      go to state 18
    sum      go to state 19
    product  go to state 20
    unary    go to state 21
    atom     go to state 22


state 12

   22 atom: ID .

    $default  reduce using rule 22 (atom)


state 13

   23 atom: NUM .

    $default  reduce using rule 23 (atom)


state 14

   24 atom: '(' . expr ')'

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    expr     go to state 25
    andexpr  go to state 17
    cmp      go to state 18
    sum      go to state 19
    product  go to state 20
    unary    go to state 21
    atom     go to state 22


state 15

   20 unary: '-' . unary

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    unary  go to state 26
    atom   go to state 22


state 16

    4 stmt: ID '=' expr . ';'
    8 expr: expr . OR andexpr

    OR   shift, and go to state 27
    ';'  shift, and go to state 28


state 17

    7 expr: andexpr .
   10 andexpr: andexpr . AND cmp

    AND  shift, and go to state 29

    $default  reduce using rule 7 (expr)


state 18

    9 andexpr: cmp .

    $default  reduce using rule 9 (andexpr)


state 19

   11 cmp: sum .
   12    | sum . EQ sum
   13    | sum . '<' sum
   15 sum: sum . '+' product
   16    | sum . '-' product

    EQ   shift, and go to state 30
    '<'  shift, and go to state 31
    '+'  shift, and go to state 32
    '-'  shift, and go to state 33

    $default  reduce using rule 11 (cmp)


state 20

   14 sum: product .
   18 product: product . '*' unary
   19        | product . '/' unary

    '*'  shift, and go to state 34
    '/'  shift, and go to state 35

    $default  reduce using rule 14 (sum)


state 21

   17 product: unary .

    $default  reduce using rule 17 (product)


state 22

   21 unary: atom .

    $default  reduce using rule 21 (unary)


state 23

    3 stmt: LET ID ';' .

    $default  reduce using rule 3 (stmt)


state 24

    5 stmt: IF '(' expr . ')' stmt ELSE stmt
    8 expr: expr . OR andexpr

    OR   shift, and go to state 27
    ')'  shift, and go to state 36


state 25

    8 expr: expr . OR andexpr
   24 atom: '(' expr . ')'

    OR   shift, and go to state 27
    ')'  shift, and go to state 37


state 26

   20 unary: '-' unary .

    $default  reduce using rule 20 (unary)


state 27

    8 expr: expr OR . andexpr

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    andexpr  go to state 38
    cmp      go to state 18
    sum      go to state 19
    product  go to state 20
    unary    go to state 21
    atom     go to state 22


state 28

    4 stmt: ID '=' expr ';' .

    $default  reduce using rule 4 (stmt)


state 29

   10 andexpr: andexpr AND . cmp

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    cmp      go to state 39
    sum      go to state 19
    product  go to state 20
    unary    go to state 21
    atom     go to state 22


state 30

   12 cmp: sum EQ . sum

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    sum      go to state 40
    product  go to state 20
    unary    go to state 21
    atom     go to state 22


state 31

   13 cmp: sum '<' . sum

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    sum      go to state 41
    product  go to state 20
    unary    go to state 21
    atom     go to state 22


state 32

   15 sum: sum '+' . product

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    product  go to state 42
    unary    go to state 21
    atom     go to state 22


state 33

   16 sum: sum '-' . product

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    product  go to state 43
    unary    go to state 21
    atom     go to state 22


state 34

   18 product: product '*' . unary

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    unary  go to state 44
    atom   go to state 22


state 35

   19 product: product '/' . unary

    ID   shift, and go to state 12
    NUM  shift, and go to state 13
    '('  shift, and go to state 14
    '-'  shift, and go to state 15

    unary  go to state 45
    atom   go to state 22


state 36

    5 stmt: IF '(' expr ')' . stmt ELSE stmt

    error  shift, and go to state 3
    ID     shift, and go to state 4
    LET    shift, and go to state 5
    IF     shift, and go to state 6

    stmt  go to state 46


state 37

   24 atom: '(' expr ')' .

    $default  reduce using rule 24 (atom)


state 38

    8 expr: expr OR andexpr .
   10 andexpr: andexpr . AND cmp

    AND  shift, and go to state 29

    $default  reduce using rule 8 (expr)


state 39

   10 andexpr: andexpr AND cmp .

    $default  reduce using rule 10 (andexpr)


state 40

   12 cmp: sum EQ sum .
   15 sum: sum . '+' product
   16    | sum . '-' product

    '+'  shift, and go to state 32
    '-'  shift, and go to state 33

    $default  reduce using rule 12 (cmp)


state 41

   13 cmp: sum '<' sum .
   15 sum: sum . '+' product
   16    | sum . '-' product

    '+'  shift, and go to state 32
    '-'  shift, and go to state 33

    $default  reduce using rule 13 (cmp)


state 42

   15 sum: sum '+' product .
   18 product: product . '*' unary
   19        | product . '/' unary

    '*'  shift, and go to state 34
    '/'  shift, and go to state 35

    $default  reduce using rule 15 (sum)


state 43

   16 sum: sum '-' product .
   18 product: product . '*' unary
   19        | product . '/' unary

    '*'  shift, and go to state 34
    '/'  shift, and go to state 35

    $default  reduce using rule 16 (sum)


state 44

   18 product: product '*' unary .

    $default  reduce using rule 18 (product)


state 45

   19 product: product '/' unary .

    $default  reduce using rule 19 (product)


state 46

    5 stmt: IF '(' expr ')' stmt . ELSE stmt

    ELSE  shift, and go to state 47


state 47

    5 stmt: IF '(' expr ')' stmt ELSE . stmt

    error  shift, and go to state 3
    ID     shift, and go to state 4
    LET    shift, and go to state 5
    IF     shift, and go to state 6

    stmt  go to state 48


state 48

    5 stmt: IF '(' expr ')' stmt ELSE stmt .

    $default  reduce using rule 5 (stmt)
